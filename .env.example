# Пример конфигурации без секретов. Реальный ключ подписывает auth/jwt.py prepare.
Auth__Issuer=motiva-benchmark
Auth__Audience=motiva-api
Auth__SigningKeyBase64=REPLACE_WITH_BASE64_KEY_FROM_auth/local/api.env
ConnectionStrings__Postgres=Host=localhost;Port=5432;Database=motiva;Username=motiva;Password=motiva
ConnectionStrings__Valkey=localhost:6379
Storage__Endpoint=localhost:9000
Storage__AccessKey=minio
Storage__SecretKey=minio123
Storage__Bucket=motiva
Storage__UseSsl=false
Company__TimeZoneId=Europe/Tallinn